[
  {
    "name": "acedatacloud_create_announcement",
    "inputSchema": {
      "properties": {
        "title": {
          "description": "Announcement title. Required.",
          "title": "Title",
          "type": "string"
        },
        "content": {
          "description": "Announcement body in Markdown. Required.",
          "title": "Content",
          "type": "string"
        },
        "rank": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional sort weight; higher shows first.",
          "title": "Rank"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional tags, e.g. ['product'].",
          "title": "Tags"
        },
        "published": {
          "default": true,
          "description": "Publish immediately (True) or save as draft (False).",
          "title": "Published",
          "type": "boolean"
        },
        "confirm": {
          "default": false,
          "description": "Must be true to actually publish.",
          "title": "Confirm",
          "type": "boolean"
        }
      },
      "required": [
        "title",
        "content"
      ],
      "title": "acedatacloud_create_announcementArguments",
      "type": "object"
    }
  },
