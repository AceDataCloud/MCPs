{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.AceDataCloud/mcp-nanobanana-pro",
  "description": "Generate and edit Nano Banana images with Ace Data Cloud; retrieve the same task for results.",
  "version": "2026.3.19.7",
  "repository": {
    "url": "https://github.com/AceDataCloud/NanoBananaMCP",
    "source": "github"
  },
  "packages": [
    {
      "identifier": "mcp-nanobanana-pro",
      "version": "2026.3.19.7",
      "transport": {
        "type": "stdio"
      },
      "registryType": "pypi",
      "runtimeHint": "uvx",
      "environmentVariables": [
        {
          "name": "ACEDATACLOUD_API_TOKEN",
          "description": "API token from Ace Data Cloud (https://platform.acedata.cloud)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "websiteUrl": "https://platform.acedata.cloud/documents/nano-banana-mcp?utm_source=mcp_registry&utm_medium=referral&utm_campaign=evergreen&utm_content=nanobanana_mcp_listing_guide",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://nanobanana.mcp.acedata.cloud/mcp"
    }
  ],
  "title": "Nano Banana by Ace Data Cloud",
  "icons": [
    {
      "src": "https://cdn.acedata.cloud/859plc.jpg",
      "mimeType": "image/jpeg"
    }
  ]
}
