        "category": "MCP"
      },
      {
        "command": "acedatacloud.nanobanana.clearApiToken",
        "title": "Nano Banana by Ace Data Cloud: Clear Ace Data Cloud API Key",
        "category": "MCP"
      }
    ]
  }
