# Environment template - copy to .env and fill in your values
# Deploy a Discord Agent Proxy at https://platform.acedata.cloud

# Discord Agent Proxy Configuration (REQUIRED)
DISCORD_BOT_BASE_URL=https://discord-bot-xxxxxxxxxxxx.app.acedata.cloud
DISCORD_BOT_TOKEN=your_bot_token_here

# Request Configuration (Optional)
DISCORD_BOT_REQUEST_TIMEOUT=30

# MCP Server Configuration (Optional)
MCP_SERVER_NAME=discord-bot
MCP_TRANSPORT=stdio

# Logging (Optional)
LOG_LEVEL=INFO
