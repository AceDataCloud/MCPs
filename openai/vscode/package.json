{
  "name": "mcp-gpt-image",
  "displayName": "GPT Image by Ace Data Cloud",
  "description": "GPT Image generation and editing by Ace Data Cloud — GPT Image 2, image tasks and results in VS Code Chat.",
  "version": "0.3.0",
  "publisher": "acedatacloud",
  "icon": "icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "mcp",
    "model context protocol",
    "ai",
    "copilot",
    "ace data cloud",
    "gpt image",
    "gpt-image",
    "gpt image 2",
    "image generation",
    "image editing"
  ],
  "galleryBanner": {
    "color": "#0E1117",
    "theme": "dark"
  },
  "homepage": "https://github.com/AceDataCloud/OpenAIMCP",
  "repository": {
    "type": "git",
    "url": "https://github.com/AceDataCloud/OpenAIMCP"
  },
  "bugs": {
    "url": "https://github.com/AceDataCloud/OpenAIMCP/issues"
  },
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "acedatacloud.openai",
        "label": "GPT Image by Ace Data Cloud"
      }
    ],
    "commands": [
      {
        "command": "acedatacloud.openai.setApiToken",
        "title": "GPT Image by Ace Data Cloud: Set Ace Data Cloud API Key",
        "category": "MCP"
      },
      {
        "command": "acedatacloud.openai.clearApiToken",
        "title": "GPT Image by Ace Data Cloud: Clear Ace Data Cloud API Key",
        "category": "MCP"
      }
    ]
  }
}
