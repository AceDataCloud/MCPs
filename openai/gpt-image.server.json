{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.AceDataCloud/mcp-gpt-image",
  "description": "Generate and edit GPT Image pictures with Ace Data Cloud; query the original image task.",
  "version": "2026.4.25.1",
  "repository": {
    "url": "https://github.com/AceDataCloud/OpenAIMCP",
    "source": "github"
  },
  "packages": [
    {
      "identifier": "mcp-openai-pro",
      "version": "2026.4.25.1",
      "transport": {
        "type": "stdio"
      },
      "registryType": "pypi",
      "runtimeHint": "uvx",
      "environmentVariables": [
        {
          "name": "ACEDATACLOUD_API_TOKEN",
          "description": "API token from Ace Data Cloud (https://platform.acedata.cloud)",
          "isRequired": true,
          "isSecret": true
        }
      ],
      "packageArguments": [
        {
          "type": "named",
          "name": "--profile",
          "value": "gpt-image"
        }
      ]
    }
  ],
  "websiteUrl": "https://github.com/AceDataCloud/OpenAIMCP/blob/main/GPT_IMAGE.md",
  "title": "GPT Image by Ace Data Cloud",
  "icons": [
    {
      "src": "https://cdn.acedata.cloud/2870040497.png",
      "mimeType": "image/png"
    }
  ]
}
