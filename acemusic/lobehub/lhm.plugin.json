    {
      "name": "acemusic_mashup_audio",
      "description": "Submit one paid two-reference mashup task targeting two songs.\n\n    Both public audio IDs must be caller-owned and compatible references.\n    The service rejects incompatible sources; never substitute references or\n    perform an extra paid upload automatically. Poll the returned task_id.\n    ",
      "inputSchema": {
        "properties": {
          "mashup_audio_ids": {
            "description": "Exactly two distinct successful caller-owned platform audio IDs.",
