              "type": "string"
            },
            "maxItems": 2,
            "minItems": 2,
            "title": "Mashup Audio Ids",
            "type": "array"
          },
          "lyric": {
            "description": "Lyrics for the new mashup.",
            "minLength": 1,
            "title": "Lyric",
            "type": "string"
          },
          "style": {
            "description": "Musical style for the new mashup.",
            "minLength": 1,
            "title": "Style",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Title"
          },
          "audio_influence": {
            "default": 60,
            "maximum": 100,
            "minimum": 1,
            "title": "Audio Influence",
            "type": "number"
          },
          "model": {
            "const": "acemusic-v1.1",
            "default": "acemusic-v1.1",
            "title": "Model",
            "type": "string"
          },
          "callback_url": {
            "anyOf": [
              {
                "type": "string"
