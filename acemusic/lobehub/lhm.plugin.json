  "tools": [
    {
      "name": "acemusic_cover_audio",
      "description": "Submit one paid cover task targeting two songs from an owned reference.\n\n    Use a public audio ID returned by a successful task. Reference compatibility\n    is checked by the service; do not upload again or generate a replacement on\n    rejection. Save the original task_id and query it instead of resubmitting.\n    ",
      "inputSchema": {
        "properties": {
          "audio_id": {
            "description": "Successful caller-owned platform audio ID, not a task ID.",
            "minLength": 1,
            "title": "Audio Id",
            "type": "string"
          },
          "lyric": {
            "description": "Lyrics for the new cover.",
            "minLength": 1,
            "title": "Lyric",
            "type": "string"
          },
          "style": {
            "description": "Musical style for the new cover.",
            "minLength": 1,
            "title": "Style",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Title"
          },
          "audio_influence": {
            "default": 60,
            "maximum": 100,
            "minimum": 1,
            "title": "Audio Influence",
            "type": "number"
          },
          "model": {
            "const": "acemusic-v1.1",
            "default": "acemusic-v1.1",
            "title": "Model",
            "type": "string"
          },
          "callback_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Callback Url"
          }
        },
        "required": [
          "audio_id",
          "lyric",
          "style"
        ],
        "title": "acemusic_cover_audioArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "acemusic_cover_audioOutput",
        "type": "object"
      }
    },
