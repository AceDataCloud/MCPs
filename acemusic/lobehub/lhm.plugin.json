    {
      "name": "acemusic_generate_music",
      "description": "Submit one ACE Music task from an idea, targeting two song candidates.\n\n    This is a paid generation. Save the returned task ID and use acemusic_get_task\n    until the group reaches a terminal state. Never resubmit to check progress.\n    A callback is optional; use a real webhook you control.\n    ",
      "inputSchema": {
        "properties": {
          "prompt": {
            "description": "Describe the song theme and musical style.",
            "minLength": 1,
            "title": "Prompt",
            "type": "string"
          },
          "model": {
