{
  "name": "mcp-toolbox",
  "displayName": "Ace Data Cloud MCP",
  "description": "One MCP toolbox for AI chat, images, video, music, search and account management. Choose from 26 hosted Ace Data Cloud services.",
  "version": "2026.1004.0",
  "publisher": "acedatacloud",
  "icon": "icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "mcp",
    "model context protocol",
    "ai",
    "copilot",
    "suno",
    "midjourney",
    "flux",
    "luma",
    "veo",
    "seedream",
    "seedance",
    "nanobanana",
    "serp",
    "music generation",
    "image generation",
    "video generation",
    "web search",
    "kling",
    "wan",
    "qwen",
    "mcp bundle"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AceDataCloud/VSCodeMCP"
  },
  "homepage": "https://platform.acedata.cloud",
  "bugs": {
    "url": "https://github.com/AceDataCloud/VSCodeMCP/issues"
  },
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "acedatacloud.bundle",
        "label": "Ace Data Cloud MCP"
      }
    ],
    "commands": [
      {
        "command": "acedatacloud.bundle.selectServices",
        "title": "Choose MCP Services",
        "category": "Ace Data Cloud"
      },
      {
        "command": "acedatacloud.bundle.setApiKey",
        "title": "Set Shared API Key",
        "category": "Ace Data Cloud"
      },
      {
        "command": "acedatacloud.bundle.setServiceApiKey",
        "title": "Set Service API Key",
        "category": "Ace Data Cloud"
      },
      {
        "command": "acedatacloud.bundle.setPlatformToken",
        "title": "Set Account Platform Token",
        "category": "Ace Data Cloud"
      },
      {
        "command": "acedatacloud.bundle.clearCredentials",
        "title": "Clear Saved Credentials",
        "category": "Ace Data Cloud"
      }
    ],
    "configuration": {
      "title": "Ace Data Cloud MCP",
      "properties": {
        "acedatacloud.bundle.services": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "acedatacloud",
              "aichat",
              "face",
              "fish",
              "flux",
              "glm",
              "grok",
              "hailuo",
              "happyhorse",
              "kling",
              "luma",
              "maestro",
              "midjourney",
              "minimax",
              "nanobanana",
              "openai",
              "producer",
              "qwen-image",
              "seedance",
              "seedream",
              "serp",
              "shorturl",
              "suno",
              "veo",
              "wan",
              "webextrator"
            ],
            "enumDescriptions": [
              "Ace Data Cloud Account",
              "AI Chat",
              "Face Transform",
              "Fish Audio",
              "Flux",
              "GLM",
              "Grok Imagine",
              "Hailuo",
              "HappyHorse",
              "Kling",
              "Luma",
              "Maestro",
              "Midjourney",
              "MiniMax",
              "NanoBanana",
              "OpenAI",
              "Producer",
              "Qwen Image",
              "Seedance",
              "Seedream",
              "Google Search",
              "Short URL",
              "Suno",
              "Veo",
              "Wan",
              "Web Extractor"
            ]
          },
          "default": [
            "flux",
            "luma",
            "midjourney",
            "nanobanana",
            "seedance",
            "seedream",
            "serp",
            "shorturl",
            "suno",
            "veo"
          ],
          "scope": "window",
          "markdownDescription": "Hosted MCP services available to Copilot Chat. Use **Ace Data Cloud: Choose MCP Services** to change this list. Account management uses a separate platform token."
        }
      }
    }
  },
  "main": "./extension.js",
  "activationEvents": [],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check extension.js && node --check scripts/verify-marketplace.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  }
}
