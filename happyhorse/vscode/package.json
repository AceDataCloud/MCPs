{
  "name": "mcp-happyhorse",
  "displayName": "HappyHorse by Ace Data Cloud",
  "description": "HappyHorse video generation by Ace Data Cloud — text, image, references, editing and task results in VS Code Chat.",
  "version": "0.3.0",
  "publisher": "acedatacloud",
  "icon": "icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "mcp",
    "model context protocol",
    "ai",
    "copilot",
    "ace data cloud",
    "happyhorse",
    "happy horse",
    "video generation",
    "image to video",
    "video editing"
  ],
  "galleryBanner": {
    "color": "#0E1117",
    "theme": "dark"
  },
  "homepage": "https://github.com/AceDataCloud/HappyHorseMCP",
  "repository": {
    "type": "git",
    "url": "https://github.com/AceDataCloud/HappyHorseMCP"
  },
  "bugs": {
    "url": "https://github.com/AceDataCloud/HappyHorseMCP/issues"
  },
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "acedatacloud.happyhorse",
        "label": "HappyHorse by Ace Data Cloud"
      }
    ],
    "commands": [
      {
        "command": "acedatacloud.happyhorse.setApiToken",
        "title": "HappyHorse by Ace Data Cloud: Set Ace Data Cloud API Key",
        "category": "MCP"
      },
      {
        "command": "acedatacloud.happyhorse.clearApiToken",
        "title": "HappyHorse by Ace Data Cloud: Clear Ace Data Cloud API Key",
        "category": "MCP"
      }
    ]
  }
}
