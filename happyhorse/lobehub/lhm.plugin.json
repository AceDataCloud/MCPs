                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional reproducibility seed.",
            "title": "Seed"
          },
          "callback_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional webhook URL. Omit it to receive a task ID for polling.",
            "title": "Callback Url"
          }
        },
        "required": [
          "prompt"
